meta {
  name: Registrar CES
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/ces
  body: json
  auth: none
}

body:json {
  {
    "contexto": "primeira_reserva",
    "nota": 4,
    "comentario": "Foi rápido, mas achei o calendário confuso."
  }
}

docs {
  nota: 1 a 5, ou null quando o usuário fecha a pesquisa sem avaliar.
  Só pode ser registrada uma vez por usuário (409 depois disso).
}
