enum Perfil {
  AlunoGraduacaoUPF              @map("Aluno graduação UPF")
  AlunoPosGraduacaoUPF           @map("Aluno pós-graduação UPF")
  AlunoCreatiUPF                 @map("Aluno Creati UPF")
  AlunoIntegradoUPF              @map("Aluno Integrado UPF")
  ProfessorOuComunidadeExterna   @map("Professor ou Comunidade externa")
  FuncionarioUPF                 @map("Funcionário UPF")
  ResidenteMultiprofissional     @map("Residente multiprofissional")
  EstudanteRedeMunicipalEstadual @map("Estudante rede municipal/estadual")
}

enum OrigemConta {
  UPF
  CONVIDADO
}

enum StatusConta {
  PENDENTE_APROVACAO
  ATIVO
}

model Usuario {
  id        String      @id @default(cuid())
  email     String      @unique
  nome      String
  perfil    Perfil?
  matricula String?
  origem    OrigemConta
  status    StatusConta @default(PENDENTE_APROVACAO)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  consentimentoLgpdEm     DateTime? @map("consentimento_lgpd_em")
  consentimentoLgpdVersao String?   @map("consentimento_lgpd_versao")

  reservas Reserva[]

  @@index([matricula])
  @@index([status])
  @@map("usuarios")
}
